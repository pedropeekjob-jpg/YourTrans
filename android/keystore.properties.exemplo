# Copiar para android/keystore.properties (que o Git ignora) e preencher.
# A chave cria-se uma vez, no Android Studio (Build › Generate Signed Bundle) ou com:
#   keytool -genkeypair -v -keystore casulo-upload.jks -alias casulo -keyalg RSA -keysize 2048 -validity 10000
# Guardar o .jks e as palavras-passe num gestor de palavras-passe. Sem eles não há atualizações
# (com a Assinatura de apps do Google Play ativa, a Google consegue repor a chave de upload).
storeFile=../casulo-upload.jks
storePassword=
keyAlias=casulo
keyPassword=
