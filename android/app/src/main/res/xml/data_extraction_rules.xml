<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada sai do aparelho por cópia na nuvem nem por transferência entre aparelhos.
     O cofre do Casulo passa de telemóvel por QR ou cópia cifrada feita pela própria pessoa. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
